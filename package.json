{
  "name": "tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write . --ignore-unknown",
    "format:check": "biome format . && prettier --check . --ignore-unknown",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.4",
    "@tailwindcss/vite": "^4.1.18",
    "daisyui": "^5.5.14",
    "events": "^3.3.0",
    "fuse.js": "^7.1.0",
    "jsonrepair": "^3.10.0",
    "lucide-solid": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "openai": "^4.78.1",
    "pouchdb-adapter-http": "^9.0.0",
    "pouchdb-adapter-idb": "^9.0.0",
    "pouchdb-core": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "pouchdb-mapreduce-no-ddocs": "^2.3.2",
    "pouchdb-quick-search": "^1.3.0",
    "pouchdb-replication": "^9.0.0",
    "solid-js": "^1.9.10",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.10.1",
    "@types/pouchdb-core": "^7.0.15",
    "esbuild": "^0.27.2",
    "prettier": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-solid": "^2.11.10"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
